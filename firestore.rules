rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function hasRole(roles) { return signedIn() && profile().rol in roles; }
    function inventoryStaff() { return hasRole(['Administrador', 'Empleado']); }
    function salesStaff() { return hasRole(['Administrador', 'Facturador']); }
    function ownsRecord() { return signedIn() && request.resource.data.usuarioId == request.auth.uid; }
    function stockHasInitialMovement(id) {
      let movementId = request.resource.data.lastMovementId;
      let path = /databases/$(database)/documents/movimientos/$(movementId);
      let movement = getAfter(path).data;
      return movementId is string && existsAfter(path)
        && movement.productoId == id
        && movement.usuarioId == request.auth.uid
        && movement.tipo == 'Entrada'
        && movement.cantidad == request.resource.data.stock;
    }
    function stockHasMovement(id) {
      let movementId = request.resource.data.lastMovementId;
      let path = /databases/$(database)/documents/movimientos/$(movementId);
      let movement = getAfter(path).data;
      return movementId is string && existsAfter(path)
        && movement.productoId == id
        && movement.usuarioId == request.auth.uid
        && ((movement.tipo == 'Entrada'
              && request.resource.data.stock == resource.data.stock + movement.cantidad)
          || (movement.tipo == 'Salida'
              && request.resource.data.stock == resource.data.stock - movement.cantidad));
    }
    function movementReferencesProduct(productId, movementId) {
      let productPath = /databases/$(database)/documents/productos/$(productId);
      let productAfter = getAfter(productPath).data;
      return existsAfter(productPath)
        && productAfter.lastMovementId == movementId;
    }
    function movementHasInvoice(movement) {
      let invoicePath = /databases/$(database)/documents/facturas/$(movement.facturaId);
      let invoice = getAfter(invoicePath).data;
      let index = movement.itemIndex;
      return movement.tipo == 'Salida'
        && movement.facturaId is string
        && index is int && index >= 0 && index < invoice.items.size()
        && !exists(invoicePath) && existsAfter(invoicePath)
        && invoice.usuarioId == request.auth.uid
        && invoice.items[index].productoId == movement.productoId
        && invoice.items[index].cantidad == movement.cantidad;
    }
    function salesStockUpdate(id) {
      let movementId = request.resource.data.lastMovementId;
      let movement = getAfter(/databases/$(database)/documents/movimientos/$(movementId)).data;
      return hasRole(['Facturador'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'lastMovementId'])
        && request.resource.data.stock is int && request.resource.data.stock >= 0
        && stockHasMovement(id) && movementHasInvoice(movement);
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || hasRole(['Administrador']));
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.rol in ['Empleado', 'Facturador'];
      allow create, update, delete: if hasRole(['Administrador']);
    }

    match /productos/{id} {
      allow read: if signedIn();
      allow create: if inventoryStaff()
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 1
        && request.resource.data.precio is number
        && request.resource.data.precio > 0
        && request.resource.data.stock is int
        && request.resource.data.stockMinimo is int
        && request.resource.data.stockMinimo >= 0
        && ((request.resource.data.stock == 0
              && !request.resource.data.keys().hasAny(['lastMovementId']))
          || stockHasInitialMovement(id));
      allow update: if inventoryStaff()
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 1
        && request.resource.data.precio is number
        && request.resource.data.precio > 0
        && request.resource.data.stock is int
        && request.resource.data.stockMinimo is int
        && request.resource.data.stockMinimo >= 0
        && ((request.resource.data.stock == resource.data.stock
              && request.resource.data.get('lastMovementId', '') == resource.data.get('lastMovementId', ''))
          || stockHasMovement(id));
      allow update: if salesStockUpdate(id);
      allow delete: if hasRole(['Administrador']);
    }

    match /movimientos/{id} {
      allow read: if signedIn();
      allow create: if (inventoryStaff() || (salesStaff() && movementHasInvoice(request.resource.data))) && ownsRecord()
        && request.resource.data.productoId is string
        && request.resource.data.tipo in ['Entrada', 'Salida']
        && request.resource.data.cantidad is int
        && request.resource.data.cantidad > 0
        && movementReferencesProduct(request.resource.data.productoId, id);
      allow update, delete: if false;
    }

    match /facturas/{id} {
      allow read: if signedIn();
      allow create: if salesStaff() && ownsRecord()
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal > 0
        && request.resource.data.iva is number
        && request.resource.data.iva >= 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
      allow update, delete: if false;
    }
  }
}
